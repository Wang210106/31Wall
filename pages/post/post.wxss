@import '/static/wxss/iconfont.wxss';
/* 全局样式 */
.container {
    display: flex;
    flex-direction: column;
    padding: 0 20rpx;
    padding-bottom: 150px;
}
/* 头像、用户名和发帖时间样式 */
.user-info {
    display: flex;
    align-items: center;
    margin-top: 30rpx;
}
.avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: 20rpx;
    object-fit: cover;
}
.username {
    font-size: 40rpx;
    font-weight: 600;
    color: #333;
}
.post-time {
    font-size: 28rpx;
    color: #999;
    margin-left: 240rpx;
}
/* 所在分区包裹层样式 */
.partition-wrapper {
    display: flex;
    justify-content: flex-end; /* 让子元素靠右对齐 */
    margin-bottom: 24rpx;
}
/* 所在分区样式 */
.partition {
    font-size: 32rpx;
    font-weight: bold;
    margin-right: 8rpx; /* 设置距离右侧为 8rpx */
    color: #a5cdf8;
}
.partition-wrapper,
.title,
.content,
.like-comment,
.comment-list {
    padding: 0 8px; /* 缩进改为 8px */
    width: 100%;
    box-sizing: border-box;
}
/* 标题样式 */
.title {
    font-size: 56rpx;
    font-weight: bold;
    color: #333;
    line-height: 1.3;
    margin-top: 16px;
}
/* 正文样式 */
.content {
    font-size: 36rpx;
    margin-top: -40rpx;
    margin-bottom: 24rpx;
    color: #666;
	line-height: 1.6;
	user-select: text;	/* 允许复制 */
}
/* 点赞和评论区样式 */
.like-comment {
    display: flex;
    margin-top: 24rpx;
    flex-wrap: wrap; /* 允许换行 */
    justify-content: space-around; /* 均匀分布按钮 */
    padding-bottom: 24rpx;
    border-bottom: 1px solid rgb(241, 241, 241);
}
.like,
.comment {
    display: flex;
    align-items: center;
    margin-right: 20rpx;
    margin-bottom: 10rpx; /* 增加底部间距 */
    cursor: pointer; /* 鼠标指针样式 */
}
.like image,
.comment image {
    width: 36rpx;
    height: 36rpx;
    margin-right: 10rpx;
}
.like text,
.comment text {
    font-size: 40rpx;
    color: #666;
}
.redlike text {
    color: rgb(55, 176, 238);
}
/* 评论输入框样式，默认隐藏 */
.comment-input {
    display: none;
}

.inputer{
    display: flex;
    align-items: center;
    margin: 10rpx 0;
}

.input-full-width {
    width: calc(100% - 100px);
    border: 1rpx solid #ccc;
    height: 80rpx;
    border-radius: 8rpx;
    font-size: 32rpx;
    box-sizing: border-box;
    padding-left: 8px;
}

.comment-input button {
    width: 80px;
    padding: 15rpx 30rpx;
    background-color: #007aff;
    color: #fff;
    border: none;
    border-radius: 8rpx;
    margin-left: 20rpx;
    font-size: 28rpx;
    cursor: pointer;
}
.comment-input button:active {
    background-color: #0056b3;
}

.anonymous-switch {
    display: flex;
    width: 100%;
    align-items: center;
}
.anonymous-switch radio-group {
    display: flex;
}
.anonymous-switch label {
    transform: scale(.8);
    margin-right: 30rpx;
    font-size: 36rpx;
    color: #666;
    display: flex;
    align-items: center;
}
.anonymous-switch radio {
    margin-right: 10rpx;
}
.comment-buttons {
    display: flex;
    justify-content: space-evenly;
    align-items: center;
}
/* 评论列表样式 */
.comment-list {
    margin-top: 30rpx;
}
.comment-item {
    display: flex;
    align-items: flex-start;
    margin-bottom: 10rpx; /* 缩小评论的上下间距 */
}
.comment-avatar {
    width: 60rpx;
    height: 60rpx;
    border-radius: 50%;
    margin-right: 20rpx;
    object-fit: cover;
}
.comment-info {
    flex: 1;
}
.comment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10rpx;
}
.comment-username {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
}
.comment-time {
    font-size: 24rpx;
    color: #999;
}
.comment-content {
    font-size: 28rpx;
    color: #666;
    line-height: 1.6;
}
.icon-quxiao {
    color: #74b7ff;
    font-size: 40rpx;
    position: absolute;
    right: 20rpx;
    top: 50%;
    transform: translateY(-50%);
    cursor: pointer;
}
/* 显示评论输入框的类 */
.show-comment-input {
    display: block;
    position: fixed;
    bottom: 0;
    border-top: 1px solid #ccc;
    padding: 0 8px; /* 缩进改为 8px */
    width: 100%;
    box-sizing: border-box;
    background-color: #fff;
}
/* 评论的点赞、举报、评论区样式 */
.comment-interaction {
    margin-top: 0rpx;
    display: flex;
    justify-content: flex-end; /* 评论部分图标右侧对齐 */
}