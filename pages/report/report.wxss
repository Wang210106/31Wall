/* pages/report/report.wxss */
.container {
	padding: 20px;
  }
  
  .prompt-text {
	font-size: 16px;
	color: #333;
	margin-bottom: 10px;
  }
  
  .input-area {
	width: 100%;
	height: 100px;
	border: 1px solid #ddd;
	border-radius: 5px;
	padding: 10px;
	margin-bottom: 20px;
	box-sizing: border-box;
  }
  
  .picker {
	margin-bottom: 20px;
  }
  
  .picker-view {
	border: 1px solid #ddd;
	padding: 10px;
	border-radius: 5px;
	background-color: #f9f9f9;
  }
  
  .submit-button {
	  width: 100%;
	  height: 50px;
	  background-color: #1aad19;
	  color: #fff;
	  border: none;
	  border-radius: 5px;
	  font-size: 16px;
  }
  
  .hint-text {
	color: red;
	font-size: 14px;
	margin-top: 10px;
  }
  
  .qa-container {
	margin-top: 20px;
  }
  
  .qa-title {
	font-size: 18px;
	font-weight: bold;
	margin-bottom: 10px;
  }
  

.qa-question {
	display: block;
	border: 1px solid #ddd;
	border-radius: 5px;
	padding: 10px;
	margin-bottom: 10px;
	cursor: pointer;
	position: relative;
	white-space: pre-wrap; /* 允许文本换行 */
	user-select: text;	/* 允许复制 */
  }
  
  .qa-question text {
	display: block;
	white-space: pre-wrap; /* 允许文本换行 */
	user-select: text;	/* 允许复制 */

  }
  
  .qa-arrow {
	width: 16px;
	height: 16px;
	position: absolute;
	right: 10px;
	top: 30%;
	transform: translateY(-50%);
  }
  
  .qa-answer {
	font-size: 14px;
	color: #666;
	margin-bottom: 10px;
	padding-left: 20px;
	white-space: pre-wrap; /* 允许文本换行 */
	user-select: text;	/* 允许复制 */

  }
  
	  