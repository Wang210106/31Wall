<!-- 搜索栏 
<view class="search-bar" style="margin: 20px 8px;">
  <input type="text" placeholder="搜索" />
</view>
-->

<!-- 轮播图 -->
<swiper class="swiper" indicator-dots="true" style="margin: 20px 8px;" autoplay="true" interval="5000" circular="true">
  <swiper-item>
    
    <image class="swiper-image" src="cloud://prod-9ggzinxb5b8ff0c5.7072-prod-9ggzinxb5b8ff0c5-1340903048/activities/band/band-logo.jpg" mode="aspectFill" bindtap="handleImageTap" data-url="/pages/activities/band/band" />
  </swiper-item>
  <swiper-item>
    <image class="swiper-image" src="cloud://prod-9ggzinxb5b8ff0c5.7072-prod-9ggzinxb5b8ff0c5-1340903048/about-us.png" mode="aspectFill" bindtap="handleImageTap" data-url="/pages/my/developer/developer" />
  </swiper-item>
  <swiper-item>
    <image class="swiper-image" src="/image/btnbar/gr0.png" mode="aspectFill" bindtap="handleImageTap" data-url="页面路径3" />
  </swiper-item>
</swiper>

<!-- 金刚区 -->
<view class="kingkong-area" style="margin: 20px 8px;">
    <view class="kingkong-wrapper">
            <!-- 循环渲染 -->
            <view class="kingkong-item {{kStatus >= 0 ? ( kStatus === item.id ? 'expended' : 'hidden') : ''}}" 
                wx:for="{{kingkongList}}" 
                wx:key="index" 
                bindtap="navigateToPage"  
                data-id="{{item.id}}">

            <!-- 显示图标 -->
            <image class="kingkong-icon" src="cloud://prod-9ggzinxb5b8ff0c5.7072-prod-9ggzinxb5b8ff0c5-1340903048/resourceImage/{{item.icon}}" mode="aspectFill" />
            <text class="kingkong-text">{{item.text}}</text>
            </view>
    </view>
    <!-- 返回按钮 -->
    <view class="toPage" wx:if="{{kStatus >= 0}}" bind:tap="toMainPage">
        <image src="/image/return.png" mode=""/>
    </view>
</view>

<view class="subt" wx:if="{{posts.length !== 0}}">
    你好，同学！
</view>

<!-- 帖子区 -->
<view class="post-area" style="margin: 20px 8px;">
  <!-- 循环渲染每个帖子 -->
  <view class="post-preview" wx:for="{{posts}}" wx:key="post_id" bindtap="navigateToPost" data-post="{{item.post_id}}">
    <!-- 用户信息：头像、用户名和发帖时间 -->
    <view class="user-info">
      <image class="avatar" src="{{item.avatar || '/image/hd1.png'}}" mode="aspectFill" />
      <text class="username">{{item.username || '匿名捏'}}</text>
      <text class="post-time">{{item.post_time}}</text>
    </view>
    <!-- 标题 -->
    <text class="post-title">{{item.title}}</text>
    <!-- 正文 -->
    <text class="post-content">{{item.content}}</text>
    <!-- 图片/视频预览 -->
    <view class="media-preview" style="{{item.mediaPreviewStyle}}">
        <!-- 单张图片预览 -->
        <image  src="{{item.images[0]}}" mode="aspectFill" wx:if="{{item.images.length === 1}}" data-image="{{item.images[0]}}"></image>
        <!-- 多张图片缩略图预览 -->
        <view class="thumbnail-grid" wx:if="{{item.images.length > 1}}">
            <!-- 循环渲染每张缩略图 -->
            <block wx:for="{{item.images}}" wx:key="*this">
            <image class="thumbnail-grid" src="{{item}}" mode="aspectFill" data-images="{{item.images}}" data-index="{{index}}"></image>
            </block>
      </view>
    </view>
    <!-- 点赞和评论按钮 -->
    <view class="interaction-buttons">
        <view class="likeandcomment">
            <view class="like-button" data-index="{{index}}">
                <text class="iconfont icon-24px" ></text>
                <text>{{item.likes_count}}</text>
            </view>
            <view class="comment-button">
                <text class="iconfont icon-pinglunxiao"></text>
                <text>{{item.comments_count}}</text>
            </view>
        </view>
        <view class="tab">
            <text>{{item.tab ? '# ' + item.tab : ''}}</text>
        </view>
    </view>
  </view>
</view>

<view class="back-to-top-btn" bindtap="backToTop" style="{{showBackTop? 'right: 20rpx; opacity: 1;' : 'right: -50rpx; opacity: 0;'}}"> 
    <image src="/image/right.png" class="back-to-top-img"></image> 
</view>

<!-- 悬浮窗按钮 -->
<view class="floating-btn" style="{{showBackTop? 'bottom: 150rpx;' : 'bottom: 50rpx;'}}" bindtap="handleFloatingBtnTap">
  <image src="/image/btnbar/tiezi2.png" mode="aspectFill"></image>
</view>

<block wx:if="{{nomore}}">
    <view class="none">{{ loading ? '加载中加载中...' :  '没有更多了捏...'}}</view>
</block>